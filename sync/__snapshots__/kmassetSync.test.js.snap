  "block_type": "parent",
  "caption_eng": Array [
    "<p>A term used in reference to contemplative practices that skip steps or work more directly in some sense.</p>",
  ],
  "caption_eng_41_content_t": Array [
    "<p>A term used in reference to contemplative practices that skip steps or work more directly in some sense.</p>",
  ],
  "cascading_position_i": 10045035,
  "created_at": "2018-02-22T04:11:00Z",
  "etymologies_ss": Array [
    "<p>Literally &ldquo;skull-traverse&rdquo; or &ldquo;crest-traverse,&rdquo; this syllabic meaning apparently indicates directly crossing the crest of a hill or mountain rather than the easier but more roundabout and gradual path of winding along the mountain stage-by-stage to gradually proceed to the other side of a pass. All of the various meanings of the term derive from that basic sense of directness vs. more gradual approaches, and apply to contemplative processes that are either more direct approaches or skip certain steps.</p>",
  ],
  "etymology_122_content_s": "<p>Literally &ldquo;skull-traverse&rdquo; or &ldquo;crest-traverse,&rdquo; this syllabic meaning apparently indicates directly crossing the crest of a hill or mountain rather than the easier but more roundabout and gradual path of winding along the mountain stage-by-stage to gradually proceed to the other side of a pass. All of the various meanings of the term derive from that basic sense of directness vs. more gradual approaches, and apply to contemplative processes that are either more direct approaches or skip certain steps.</p>",
  "etymology_122_type_subjects-202_s": "Basic Syllabic Etymology",
