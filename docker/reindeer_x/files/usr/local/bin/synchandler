#!/usr/bin/perl
my $CLASS="production";
my $TMPFILE = "/tmp/synch.$$";
my $DRYRUN = ""; # "--dry-run";
my $FLAGS = "";
# print join(' ',@ARGV),"\n";
@args=@ARGV;
$SRC=pop @args;

# only normal files with actual contents ending with .json
#
@files=map {  ( $_=~/\.json$/ && -f "$SRC/$_" && -s "$SRC/$_")?$_:() } @args;
# @files=@args;
$files=join("\n",@files);

if (!$files) {
	print "nothing to do...\n";
	exit(0);
}
# print "src=",$src,"\n";
# print "files=\n",$files, "\n"; 

open (fh, ">", $TMPFILE) or die "Can't open tempfile $TMPFILE: $!\n";
print fh $files,"\n";
close fh or die "Error closing tempfile $TMPFILE: $!\n";

# print "TMPFILE=$TMPFILE\n";
# print "FLAGS=$FLAGS\n";

$ret=`rclone copy $DRYRUN --checksum --files-from $TMPFILE $FLAGS $SRC s3:mandala-ingest-${CLASS}-inbound/kmassets-inbound/test/reindeer_x 2>&1`;

if ($ret) { print "$TMPFILE:\n$ret\n"; } else { print "$TMPFILE: success\n"; unlink $TMPFILE };
